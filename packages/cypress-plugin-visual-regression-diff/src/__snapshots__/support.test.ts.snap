// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateOverlayTemplate > generates proper template 1`] = `
"<div class="cp-visual-regression-diff-overlay" style="position:fixed;z-index:100000;top:0;bottom:0;left:0;right:0;display:flex;flex-flow:column;background:#1a202c;font-family:sans-serif">
  <header style="background:#2d3748;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-shrink:0">
    <div style="display:flex;align-items:center;gap:12px">
      <div style="width:28px;height:28px;flex-shrink:0"><svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" viewBox="0 0 72 72"><circle cx="35.5" cy="36.5" r="27.5" fill="#4A4A4D" stroke="#FFF"/><g fill="#FFF" transform="matrix(.075 0 0 .075 16 17)"><circle cx="259.8" cy="259.9" r="80"/><path d="M511.7 237.7C450.2 163.4 357 92 259.8 92 162.5 91.9 69.4 163.4 8 237.7A34.8 34.8 0 0 0 8 282a520.8 520.8 0 0 0 91 86.2c109 79.3 212.4 79.5 321.6 0a520.8 520.8 0 0 0 91-86.2 34.8 34.8 0 0 0 0-44.3zM259.8 148a112.1 112.1 0 0 1 0 224 112.1 112.1 0 0 1 0-224z"/></g></svg></div>
      <span style="font-weight:600;color:#fff;font-size:.95em">some title – screenshot diff</span>
    </div>
    <button type="button" data-type="close" style="background:transparent;border:1px solid #4a5568;color:#a0aec0;padding:6px 12px;border-radius:4px;cursor:pointer;font-size:.85em">✕ Close</button>
  </header>
  <div data-diff-base64="img-diff-base64" style="flex:1;overflow:auto;padding:20px;color:#fff">
    <div data-pix-root style="display:flex;justify-content:center;align-items:flex-start;gap:16px"><style>
  [data-pix-panel] [data-pix-old] { opacity:1; }
  [data-pix-panel] [data-pix-new] { opacity:0; }
  [data-pix-panel][data-side="actual"] [data-pix-old] { opacity:0; }
  [data-pix-panel][data-side="actual"] [data-pix-new] { opacity:1; }
  [data-pix-panel] [data-pin-side="actual"] { display:none; }
  [data-pix-panel][data-side="actual"] [data-pin-side="actual"] { display:block; }
  [data-pix-panel][data-side="actual"] [data-pin-side="baseline"] { display:none; }
  [data-pix-root][data-pins="off"] [data-pix-pins] { display:none; }
  [data-pix-box] { visibility:hidden; }
  [data-pix-root][data-lit="1"] [data-pix-box="1"] { visibility:visible; } [data-pix-root][data-lit="1"] [data-pix-line="1"] { background:#2d3748; } [data-pix-root][data-lit="2"] [data-pix-box="2"] { visibility:visible; } [data-pix-root][data-lit="2"] [data-pix-line="2"] { background:#2d3748; } [data-pix-root][data-lit="3"] [data-pix-box="3"] { visibility:visible; } [data-pix-root][data-lit="3"] [data-pix-line="3"] { background:#2d3748; } [data-pix-root][data-lit="4"] [data-pix-box="4"] { visibility:visible; } [data-pix-root][data-lit="4"] [data-pix-line="4"] { background:#2d3748; } [data-pix-root][data-lit="5"] [data-pix-box="5"] { visibility:visible; } [data-pix-root][data-lit="5"] [data-pix-line="5"] { background:#2d3748; } [data-pix-root][data-lit="6"] [data-pix-box="6"] { visibility:visible; } [data-pix-root][data-lit="6"] [data-pix-line="6"] { background:#2d3748; } [data-pix-root][data-lit="7"] [data-pix-box="7"] { visibility:visible; } [data-pix-root][data-lit="7"] [data-pix-line="7"] { background:#2d3748; } [data-pix-root][data-lit="8"] [data-pix-box="8"] { visibility:visible; } [data-pix-root][data-lit="8"] [data-pix-line="8"] { background:#2d3748; } [data-pix-root][data-lit="9"] [data-pix-box="9"] { visibility:visible; } [data-pix-root][data-lit="9"] [data-pix-line="9"] { background:#2d3748; } [data-pix-root][data-lit="10"] [data-pix-box="10"] { visibility:visible; } [data-pix-root][data-lit="10"] [data-pix-line="10"] { background:#2d3748; }
</style>
    <div
      data-pix-panel data-side="baseline"
      style="position:relative;flex:0 1 auto;min-width:0;background:#fff;border:solid 15px #fff;overflow:hidden;color:#1a202c"
      onmouseover="this.dataset.side='actual'"
      onmouseleave="this.dataset.side='baseline'"
    >
      <h3 style="margin:0 0 8px">New screenshot (hover off to see old one):</h3>
      <div style="position:relative;display:inline-block;max-width:100%">
        <img data-pix-new style="display:block;min-width:200px;max-width:100%" src="data:image/png;base64,img-new-base64" />
        <div data-pix-pins style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:2"></div>
      </div>
      <div data-pix-old style="position:absolute;top:0;left:0;width:100%;background:#fff">
        <h3 style="margin:0 0 8px">Old screenshot (hover to see new one):</h3>
        <img style="display:block;min-width:200px;max-width:100%" src="data:image/png;base64,img-old-base64" />
      </div>
    </div>
    
    
    
    
  </div>
  </div>
  <div style="background:#1a202c;padding:0 16px 10px;display:flex;justify-content:flex-end;flex-shrink:0">
    <button data-type="see-diff" style="background:#4a5568;border:none;color:#fff;padding:6px 14px;border-radius:4px;cursor:pointer;font-size:.85em">See diff image →</button>
  </div>
  <footer style="background:#2d3748;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-shrink:0">
    <div></div>
    <div style="display:flex;gap:8px">
      <button type="button" data-type="replace" style="background:#38a169;border:none;color:#fff;padding:8px 16px;border-radius:4px;cursor:pointer;font-weight:600">✓ Replace image</button>
    </div>
    <div></div>
  </footer>
</div>"
`;

