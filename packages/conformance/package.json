    "@pixsame/playwright": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "cypress": "16.1.0",
    "meta-png": "1.0.6",
    "prettier": "3.9.8",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "visual-regression-manifest": "1.0.0-beta.2",
    "vitest": "4.1.11"
  }
