{
  "name": "@pixsame/conformance",
  "private": true,
  "version": "0.0.0",
  "description": "Runs the same visual-regression scenarios through the real Cypress and Playwright adapters and checks what lands on disk and in the run manifest.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
